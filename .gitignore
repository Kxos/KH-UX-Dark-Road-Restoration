# ---------------------------------------------------------------------------
# Materiale proprietario Square Enix — NON deve MAI finire nel repository.
# Sono file che l'utente si procura da sé; qui vivono solo in locale.
# ---------------------------------------------------------------------------
recon/dl/
recon/ext/
recon/web/blobs/
recon/web/parts/
recon/web/*.html
recon/web/*.zip

*.apk
*.xapk
*.ipa
*.obb
*.so
*.dylib
*.wasm
*.jsc
*.unity3d
*.dat
*.bin

# Dump di stringhe estratte dai binari: opere derivate, e rigenerabili
# in pochi secondi con recon/tools/strings.py
recon/out/strings_*.txt
recon/out/field_candidates_*.txt

# ---------------------------------------------------------------------------
# Progetti di reverse engineering
#
# Il progetto Ghidra contiene una copia del binario importato, e il decompilato
# e' opera derivata da codice Square Enix: resta tutto in locale.
# ---------------------------------------------------------------------------
recon/ghidra/project/
recon/ghidra/out/
*.gpr
*.rep/
ghidra_*/
ghidra_*.zip
.ghidra/

# ---------------------------------------------------------------------------
